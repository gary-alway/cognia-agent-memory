{
  "mcpServers": {
    "cognia-memory": {
      "command": "node",
      "args": [
        "dist/src/server/mcp-server.js"
      ],
      "cwd": "${workspaceFolder}",
      "env": {
        "NEO4J_URI": "bolt://localhost:7687",
        "NEO4J_USER": "neo4j",
        "NEO4J_PASSWORD": "password",
        "OLLAMA_HOST": "localhost",
        "OLLAMA_PORT": "12434"
      }
    }
  }
}

